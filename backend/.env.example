# ── AssemblyAI ────────────────────────────────────────────────────────────
# Server-only secret. NEVER ship this to the browser -- the frontend gets a
# short-lived token from GET /api/token instead (see main.py). The browser
# then connects DIRECTLY to wss://agents.assemblyai.com/v1/ws. Client-side
# tools execute in the browser; this key stays on the server.
ASSEMBLYAI_API_KEY=

# us | eu -- picks the LLM Gateway + agents host region
ASSEMBLYAI_REGION=us

# Exa (https://exa.ai) live web search key, backing the web_search tool
# (web_search.py). Free tier, no credit card required. AssemblyAI itself does
# not provide a hosted search data source -- its Voice Agent API only offers
# tool-calling plumbing (client-side tools, HTTP tools), so a search provider
# key is required for the agent to answer time-sensitive questions.
EXA_API_KEY=

# Only used by the offline text-chat fallback (discuss.py / POST /api/mock_chat)
# when MOCK_MODE is on and you want LLM-quality replies instead of the canned
# heuristic. Use the Gateway API model ID, not its provider/model display label:
# `claude-opus-5`, not `anthropic/claude-opus-5`. Model access is account-
# specific; if Opus 5 returns an access error, keep an enabled model here.
LLM_GATEWAY_MODEL=claude-opus-5
# Optional separate Gateway model for live text sentiment; defaults to the
# model above so it works with the same models your account can access.
SENTIMENT_MODEL=claude-opus-5

# Explicit Anthropic prompt caching for future *direct* LLM Gateway calls.
# These settings are not sent in the stored Voice Agent `llm` block because
# that schema exposes only base_url/model/api_key and no cache-control field.
LLM_GATEWAY_PROMPT_CACHE_ENABLED=true
LLM_GATEWAY_PROMPT_CACHE_TTL=5m

# ── Agent ─────────────────────────────────────────────────────────────────
# Filled in automatically by `python publish_agent.py` after the first publish.
AGENT_ID=
AGENT_VOICE_ID=alba

# Model used by the stored Voice Agent through AssemblyAI's region-matched LLM
# Gateway. Leave blank to inherit LLM_GATEWAY_MODEL. The same AssemblyAI key is
# supplied server-side when publishing. Enable only after confirming your
# account can call the model; otherwise the Voice Agent uses its managed model.
AGENT_LLM_MODEL=
AGENT_CUSTOM_LLM_ENABLED=false

# Server-side noise cancellation. Use far-field for laptop/room microphones
# and near-field for a close headset/handset mic. Higher threshold values
# suppress more aggressively (0.0-1.0); 0.8 follows the far-field example
# in AssemblyAI's Voice Focus guide.
AGENT_VOICE_FOCUS=far-field
AGENT_VOICE_FOCUS_THRESHOLD=0.8

# Balanced transcription uses AssemblyAI's normal speed/accuracy tradeoff.
# The contextual prompt is capped at 1750 characters. Keyterms are comma-
# separated, capped at 100 entries (and 50 characters per entry here).
AGENT_TRANSCRIPTION_MODE=balanced
AGENT_TRANSCRIPTION_PROMPT=A voice-first discussion about any topic. The user may speak English, Hindi, or naturally code-switch in Hinglish. Expect names, technical terms, acronyms, and numbers from many subject areas.
AGENT_KEYTERMS=AssemblyAI,VoiceAI,Claude,Voice Focus,Hinglish

# STT language steering (comma-separated ISO codes). Without this, automatic
# multilingual detection can drift -- e.g. English speech transcribed as
# phonetic Hindi script. Add every language you actually expect to speak.
AGENT_LANGUAGE_CODES=en,hi

# true  -> GET /api/token returns a fake token and the frontend falls back to
#          the text-chat box (POST /api/mock_chat) instead of a real voice
#          call. Lets you build/demo the discuss-and-debate behaviour before
#          you have an AssemblyAI key.
# false -> mint real tokens; the browser makes a real voice call.
MOCK_MODE=true

# CORS origin for the static frontend (app.html). "*" is fine for a hackathon
# demo.
FRONTEND_ORIGIN=*
